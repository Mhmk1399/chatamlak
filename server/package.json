{
  "name": "songbird-server",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bllackbull/songbird.git"
  },
  "bugs": {
    "url": "https://github.com/bllackbull/songbird/issues"
  },
  "homepage": "https://github.com/bllackbull/songbird#readme",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=. --watch-path=../.env index.js",
    "start": "node index.js",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:bench": "vitest bench --run",
    "db:delete": "node scripts/mongo-cli.js delete",
    "db:reset": "node scripts/mongo-cli.js reset",
    "db:backup": "node scripts/mongo-cli.js backup",
    "db:restore": "node scripts/mongo-cli.js restore",
    "db:vacuum": "node scripts/mongo-cli.js vacuum",
    "db:help": "node scripts/mongo-cli.js help",
    "db:migrate": "node scripts/mongo-cli.js migrate",
    "db:backfill": "node scripts/backfill-message-file-metadata.js",
    "db:chat:create": "node scripts/mongo-cli.js chat:create",
    "db:chat:add": "node scripts/mongo-cli.js chat:add",
    "db:chat:edit": "node scripts/mongo-cli.js chat:edit",
    "db:chat:verify": "node scripts/mongo-cli.js chat:verify",
    "db:chat:delete": "node scripts/mongo-cli.js chat:delete",
    "db:file:delete": "node scripts/mongo-cli.js file:delete",
    "db:user:edit": "node scripts/mongo-cli.js user:edit",
    "db:user:ban": "node scripts/mongo-cli.js user:ban",
    "db:user:verify": "node scripts/mongo-cli.js user:verify",
    "db:user:delete": "node scripts/mongo-cli.js user:delete",
    "db:user:create": "node scripts/mongo-cli.js user:create",
    "db:owner:check": "node scripts/mongo-cli.js owner:check",
    "db:user:generate": "node scripts/mongo-cli.js user:generate",
    "db:message:generate": "node scripts/mongo-cli.js message:generate",
    "db:inspect": "node scripts/mongo-cli.js inspect",
    "db:chat:inspect": "node scripts/mongo-cli.js chat:inspect",
    "db:user:inspect": "node scripts/mongo-cli.js user:inspect",
    "db:file:inspect": "node scripts/mongo-cli.js file:inspect",
    "remote:configure": "node scripts/configure-remote-channel.js",
    "storage:cors": "node scripts/configure-bucket-cors.js",
    "storage:migrate": "node scripts/migrate-storage-layout.js",
    "db:check": "node scripts/mongo-cli.js check",
    "db:import-sql": "node scripts/mongo-cli.js import-sql",
    "test:mongo": "vitest --config vitest.mongo.config.js --run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.19",
    "compression": "^1.8.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "mongodb": "^7.8.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sql.js": "^1.15.1",
    "telegram": "^2.26.22",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "fast-check": "^4.10.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
